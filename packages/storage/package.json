{
  "name": "@vistect/storage",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./eventStore": {
      "types": "./dist/eventStore/index.d.ts",
      "import": "./dist/eventStore/index.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots/index.d.ts",
      "import": "./dist/snapshots/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "import": "./dist/keys/index.js"
    },
    "./quota": {
      "types": "./dist/quota/index.d.ts",
      "import": "./dist/quota/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "nanoid": "^5.0.0",
    "@vistect/domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.2.6",
    "tsx": "^4.19.0",
    "@vistect/testing": "workspace:*",
    "happy-dom": "^20.8.9"
  }
}
