{
  "name": "vistect",
  "version": "0.0.0",
  "private": true,
  "description": "Vistect \u2014 WebMCP-native accessible visual document workspace",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @vistect/web dev",
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter './packages/**' run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "pnpm --filter @vistect/web test:e2e",
    "test:ci": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build && pnpm test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite coverage",
    "db:generate": "pnpm --filter @vistect/domain run db:generate",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "playwright": "^1.47.0",
    "@axe-core/playwright": "^4.10.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0",
    "idb": "^8.0.0",
    "nanoid": "^5.0.0",
    "zustand": "^4.5.0",
    "elkjs": "^0.9.0",
    "dagre": "^0.8.5",
    "pdf-lib": "^1.17.0",
    "dompurify": "^3.1.0",
    "jsdom": "^25.0.0",
    "happy-dom": "^20.8.9",
    "@types/dagre": "^0.7.52",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@playwright/test": "^1.47.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
