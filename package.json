{
  "name": "vistect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent visual authorship for blind creators. WebMCP-native accessible document studio.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "npm run typecheck:core && npm run typecheck:app",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:app": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "probe:webmcp": "node scripts/probe-webmcp.mjs",
    "spike:measure": "node spikes/dom-measure.mjs",
    "spike:pdf": "node spikes/pdf-export.mjs",
    "chrome": "google-chrome --enable-blink-features=WebMCP http://localhost:5173"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "dagre": "0.8.5",
    "idb": "8.0.3",
    "nanoid": "6.0.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/dagre": "0.7.54",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "webmcp-types": "0.1.6"
  }
}
